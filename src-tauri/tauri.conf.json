{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhysicsLab", "version": "0.1.0", "identifier": "cz.physicslab.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:5173", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "PhysicsLab", "width": 1440, "height": 960, "minWidth": 1000, "minHeight": 700 }], "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; script-src 'self'; connect-src ipc: http://ipc.localhost" } },
  "bundle": { "active": false }
}

